# WhatIf (PlacePatch) mobile config — copy to mobile/.env and fill in.
# Source of truth: docs/MASTER_PLAN.md §6.2
# Read ONLY in mobile/src/config.ts. EXPO_PUBLIC_* values ship inside the app
# bundle, so NEVER put secrets here. Restart `npx expo start` after editing.

# fixture = bundled sample data, no backend, permanent "NOT LIVE AI" banner
# live    = talk to the Django API at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_API_MODE=fixture

# Must end in /api/v1 and be reachable from the phone (tunnel URL, not localhost).
# Quick tunnels change URL on restart — update this and restart Expo.
EXPO_PUBLIC_API_BASE_URL=https://xyz.trycloudflare.com/api/v1

# Auth0 Native application (client IDs are public; no client secret here).
# Allowed Callback URL = the redirect URI shown in Profile → Developer.
EXPO_PUBLIC_AUTH0_DOMAIN=placepatch.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.placepatch.dev
EXPO_PUBLIC_AUTH0_SCHEME=placepatch

# How often the app polls an AI job (ms).
EXPO_PUBLIC_JOB_POLL_MS=2000

# Optional: Google Maps key for the native map on Android builds (iOS uses Apple Maps).
# Without it the Map tab shows a placeholder. Read at build time by mobile/app.config.js
# (not EXPO_PUBLIC_, it is compiled into the Android manifest), then re-run prebuild.
GOOGLE_MAPS_ANDROID_API_KEY=
